+                'figcaption':str(record.get('publisher_img_title')
+                    or item.get('publisher_img_title') or '')[:260],
+                'section_heading':'','context_text':'',
+                'article_title':str(article.get('title') or '')[:180]})
+    result=[]
+    for (aid,url),images in allowed_by_article.items():
+        if not images:
+            continue
