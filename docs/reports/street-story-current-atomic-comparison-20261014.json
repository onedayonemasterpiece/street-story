        {
          "fact_id": "claim_1ec61671550507842e76",
          "text": "В недатированном описании гида говорится, что здание Отто-Браун-хаус «выстояло» благодаря железобетонной конструкции. Это атрибутированное объяснение сохранности здания; источник не уточняет, какие именно повреждения оно пережило и когда.",
          "claim_key": "otto_braun_house_reinforced_concrete_survival",
          "eligibility": "eligible",
          "review_status": "eligible",
          "eligibility_reason": "accepted_basis",
          "revision_digest": "v2:65623da31022cad4489a639c22ec0f31f38e8a50d07e96486cd7b8434246ce71",
          "sources": [
            {
              "assessment_origin": "native_research_single_model",
              "confirmation_checks": {
                "material_kind": "architecture",
                "object_relation": "selected_building",
                "relation_basis": {
