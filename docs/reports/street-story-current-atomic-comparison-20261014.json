      "raw_cards": [
        {
          "fact_id": "claim_0fdf1d2f27a1a4a358e8",
          "text": "В статье об истории восточнопрусского рабочего движения в выпуске «Ostpreußen-Warte» за июнь 1958 года сообщается, что в 1930 году редакция и типография ежедневной газеты «Königsberger Volkszeitung» переехали в новопостроенный дом Отто Брауна на II Флисштрассе. Городская справка связывает дом Отто Брауна с адресом Профессора Севастьянова, 3–5.",
          "claim_key": "otto_braun_house_received_konigsberger_volkszeitung_offices_1930",
          "eligibility": "eligible",
          "review_status": "eligible",
          "eligibility_reason": "accepted_basis",
          "revision_digest": "v2:b04f92d0a872f76dbb542a5d0cb7452cccf2434b3ae8cf89ad9e31f25a17c93a",
          "sources": [
            {
              "assessment_origin": "native_research_single_model",
              "confirmation_checks": {
                "material_kind": "history",
                "object_relation": "selected_building",
                "relation_basis": {
                  "chunk_ids": [
                    "chunk_3bcc8b9c317c7059710e2514"
                  ],
                  "fragment": "Redaktion und Druckerei im Jahre 1930 in das neuerrichtete Otto-Braun-Haus in der II. Fließstraße übersiedelten",
                  "fragment_kind": "model_confirmed_fragment",
                  "fragment_original_sha256": "3674f9e7370b542c98a43a8d96d8239907f8573901647a51fc6c8f7370ce509a",
                  "fragment_truncated": false
                },
                "source_physical_subject": "Дом Отто Брауна на II Флисштрассе; утверждение касается переезда редакции и типографии газеты «Königsberger Volkszeitung» в 1930 году.",
                "temporal_basis": "historical",
                "temporal_preserved": true
              },
              "confirmation_reason": "Фрагмент прямо относит переезд редакции и типографии к новопостроенному Otto-Braun-Haus и датирует его 1930 годом. Связь исторического здания с выбранным домом подтверждается официальной городской справкой, называющей здание Отто Брауна и адрес Профессора Севастьянова, 3–5; текст сохраняет дату и предмет переезда, не утверждая, что туда переехала вся газета как организация.",
              "confirmed_fragment_kind": "model_confirmed_fragment",
              "confirmed_fragment_original_sha256": "3674f9e7370b542c98a43a8d96d8239907f8573901647a51fc6c8f7370ce509a",
              "confirmed_fragment_truncated": false,
              "original_native_attempt_id": "rattempt_f771195f86ef558932cd6853",
              "source_date": "1958-06",
              "source_version_id": "srcv_b5ce6ea346c28594caa47d93",
              "subject_scope": "selected_building",
              "title": "https://www.ahnen-spuren.de/Members/inge4013/ostpreussische-nachrichten/ostpreussen-warte/ostpreussen-warte-1958/ostpreussen-warte-1958/ostpreussen-warte-folge-06-vom-juni-1958.pdf/%40%40download/file/Ostpreu%C3%9Fen-Warte%2C%20Folge%2006%20vom%20Juni%201958.pdf",
