{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://street-story/contracts/poi.fact_evidence.v1",
  "title": "POI fact evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_id",
    "idempotency_key",
    "producer",
    "scope",
    "source",
    "poi_locator",
    "claim",
    "evidence"
  ],
  "properties": {
    "contract_version": {
      "const": "poi.fact_evidence.v1"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "producer": {
      "type": "string",
      "enum": [
        "regional_knowledge",
        "street_story"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "private",
            "workspace",
            "public"
          ]
        },
        "owner_sub": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_ref",
        "revision",
        "title"
      ],
      "properties": {
        "document_ref": {
          "type": "string",
          "pattern": "^knowledge://documents/"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "publication_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 3000
        }
      }
    },
    "poi_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "names",
        "external_ids"
      ],
      "properties": {
        "names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "external_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "semantic_key",
        "kind",
        "text"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "format": "uuid"
        },
        "semantic_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "kind": {
          "type": "string",
          "enum": [
            "construction",
            "architect",
            "foundation",
            "reconstruction",
            "demolition",
            "ownership",
            "visit",
            "use",
            "opening",
            "location",
            "structure",
            "other"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "time_scope": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_ref",
        "page_ids",
        "region_ids",
        "source_family_id",
        "score_policy_version"
      ],
      "properties": {
        "evidence_ref": {
          "type": "string",
          "pattern": "^knowledge://evidence/"
        },
        "page_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "region_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "source_family_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "author_profile_refs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^knowledge://authors/"
          }
        },
        "author_subject_authority": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "publication_method_score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "provenance_precision_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "evidence_verification_score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "score_policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  }
}
