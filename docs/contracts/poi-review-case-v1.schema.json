{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://street-story/contracts/poi.review_case.v1",
  "title": "POI expert review case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "review_case_id",
    "poi_id",
    "status",
    "relation",
    "claims",
    "required_expertise",
    "scope"
  ],
  "properties": {
    "contract_version": {
      "const": "poi.review_case.v1"
    },
    "review_case_id": {
      "type": "string",
      "format": "uuid"
    },
    "poi_id": {
      "type": "string",
      "format": "uuid"
    },
    "conflict_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "assigned",
        "in_review",
        "resolved",
        "deferred",
        "superseded"
      ]
    },
    "relation": {
      "type": "string",
      "enum": [
        "contradiction",
        "scope_difference",
        "temporal_sequence",
        "source_disagreement",
        "uncertain",
        "identity_ambiguity"
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "evidence_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "verification_score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        }
      }
    },
    "required_expertise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geography": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "period": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "subject": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "languages": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 50
          }
        }
      }
    },
    "required_reviews": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "default": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "private",
            "workspace",
            "public"
          ]
        },
        "owner_sub": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "detector_suggestion": {
      "type": [
        "object",
        "null"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
