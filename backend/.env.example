DATA_DIR=/var/lib/street-story
STREET_STORY_DEVICE_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
VIBEPUBLISH_BASE_URL=http://127.0.0.1:8765
VIBEPUBLISH_BEARER_TOKEN=
STREET_STORY_OSM_USER_AGENT=StreetStory/0.1 (+https://github.com/onedayonemasterpiece/street-story)
WORKER_POLL_SECONDS=1

# Explicit existing secret refs (GOOGLE_API_KEY2 and GOOGLE_API_KEY_2 both work).
# Example: GEMINI_API_KEY_REFS='["GOOGLE_API_KEY","GOOGLE_API_KEY2"]'
# Alternatively GEMINI_API_KEYS='["<secret-one>","<secret-two>"]'. Never commit values.
# Explicit pools take precedence over the legacy single GEMINI_API_KEY; duplicates removed.
GEMINI_API_KEY_REFS=
GEMINI_API_KEYS=
GEMINI_CALL_TIMEOUT_SECONDS=20
GEMINI_ATTEMPT_TIMEOUT_SECONDS=60
# Optional local per-workload request caps. 0 tracks usage without inventing a limit.
GEMINI_TRANSCRIPTION_RPM=0
GEMINI_GROUNDED_RESEARCH_RPM=0
PROCESSING_DELAYED_AFTER_SECONDS=1800
# REQUIRED for Gemini calls: existing shared reserve / mark_sent / finalize controller.
# Without controller access no provider call is sent. Registered env refs must resolve locally.
# Copy only approved required credentials, never another project's entire environment.
GEMINI_QUOTA_SUPABASE_URL=
GEMINI_QUOTA_SUPABASE_KEY=
